                android:startY="34"
                android:endX="66"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFBA68C8" />
                <item android:offset="0.5" android:color="#FF9C27B0" />
                <item android:offset="1.0" android:color="#FFE040FB" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Modern Minimalist Flag Beam -->
    <path
        android:pathData="M60,34 C68,34 76,38 78,46 C74,42 67,41 60,42 Z">
        <aapt:attr name="android:fillColor">

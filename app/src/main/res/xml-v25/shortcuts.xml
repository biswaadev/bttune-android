<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/search"
        android:shortcutId="search"
        android:shortcutShortLabel="@string/search">
        <intent
            android:action="com.bt.bttune.action.SEARCH"
            android:targetClass="com.bt.bttune.MainActivity"
            android:targetPackage="com.bt.bttune" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/explore"
        android:shortcutId="explore"
        android:shortcutShortLabel="@string/explore">
        <intent
            android:action="com.bt.bttune.action.EXPLORE"
            android:targetClass="com.bt.bttune.MainActivity"
            android:targetPackage="com.bt.bttune" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/library_music"
        android:shortcutId="library"
        android:shortcutShortLabel="@string/filter_library">
        <intent
            android:action="com.bt.bttune.action.LIBRARY"
            android:targetClass="com.bt.bttune.MainActivity"
            android:targetPackage="com.bt.bttune" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/mic"
        android:shortcutId="music_recognition"
        android:shortcutShortLabel="@string/identify_music">
        <intent
            android:action="com.bt.bttune.action.MUSIC_RECOGNITION"
            android:targetClass="com.bt.bttune.MainActivity"
            android:targetPackage="com.bt.bttune" />
    </shortcut>
